# Selecciona la fuente de datos. Valores: "local" | "supabase"
# - "local" (por defecto): persistencia en LocalStorage del navegador.
# - "supabase": usa las clases SupabasePrinterRepository / SupabaseCalendarRepository
#   (requiere completar su implementación antes de cambiar este valor en producción).
NEXT_PUBLIC_DATA_SOURCE="local"

# Credenciales del proyecto Supabase (necesarias solo cuando DATA_SOURCE="supabase")
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
